<Window x:Class="Nexus.MVVM.View.LoginWindow"
        xmlns="http://schemas.microsoft.com/winfx/2006/xaml/presentation"
        xmlns:x="http://schemas.microsoft.com/winfx/2006/xaml"
        xmlns:d="http://schemas.microsoft.com/expression/blend/2008"
        xmlns:mc="http://schemas.openxmlformats.org/markup-compatibility/2006"
        xmlns:local="clr-namespace:Nexus.MVVM.View"
        mc:Ignorable="d"
        Height="710"
        Width="580"
        Background="Transparent"
        WindowStyle="None"
        AllowsTransparency="True">

    <!--Styles-->
    <Window.Resources>
        <Style x:Key="MinMaxCloseButton"
               TargetType="Button">

            <Setter Property="BorderThickness" 
                    Value="0"/>
            <Setter Property="Cursor" 
                    Value="Hand"/>
            <Setter Property="Foreground" 
                    Value="White"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <!--ROOT-->
                        <Border x:Name="Root"
                                CornerRadius="15">

                            <!--GRADIENT-->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <!--NORMAL-->
                                    <GradientStop x:Name="StopTop"
                                                  Color="#FF6800"
                                                  Offset="0"/>
                                    <GradientStop x:Name="StopBottom"
                                                  Color="#e64500"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <!--NORMAL-->
                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF6800"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#e64500"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>

                                    <!--HOVER-->
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFB347"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF7A18"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>

                                    <!--PRESSED-->
                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFD166"
                                                            Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF9F1C"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedTextboxStyle"
               TargetType="TextBox">

            <!--Basis-->
            <Setter Property="Background" 
                    Value="Black"/>
            <Setter Property="Foreground" 
                    Value="#8c8c8c"/>
            <Setter Property="BorderThickness" 
                    Value="0"/>
            <Setter Property="Padding" 
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="TextBox">
                        <Border x:Name="border"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4d1700"
                                BorderThickness="2">

                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!--ICON-->
                                <Image Source="/Icons/NexusLoginUsernameIcon.png"
                                       Width="22"
                                       Height="22"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Margin="5,0,0,0"/>

                                <!--TEXT-->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Foreground="#8c8c8c"
                                              Grid.Column="1"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <Trigger Property="IsMouseOver" 
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#FF6800"/>
                            </Trigger>

                            <Trigger Property="IsKeyboardFocused" 
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#FF6800"/>
                            </Trigger>

                            <Trigger Property="IsEnabled" 
                                     Value="False">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedPasswordboxStyle"
               TargetType="PasswordBox">

            <!--Basis-->
            <Setter Property="Background"
                    Value="Black"/>
            <Setter Property="Foreground"
                    Value="#8c8c8c"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Padding"
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="PasswordBox">
                        <Border x:Name="border"
                                CornerRadius="15"
                                Background="{TemplateBinding Background}"
                                BorderBrush="#4d1700"
                                BorderThickness="2">

                            <!--ICON + PASSWORD-->
                            <Grid>
                                <Grid.ColumnDefinitions>
                                    <ColumnDefinition Width="32"/>
                                    <ColumnDefinition Width="*"/>
                                </Grid.ColumnDefinitions>

                                <!--ICON-->
                                <Image Source="/Icons/NexusLoginPasswordIcon.png"
                                       Width="19"
                                       Height="19"
                                       VerticalAlignment="Center"
                                       HorizontalAlignment="Center"
                                       RenderOptions.BitmapScalingMode="Fant"
                                       Margin="5,0,0,0"/>

                                <!--PASSWORD INPUT-->
                                <ScrollViewer x:Name="PART_ContentHost"
                                              Foreground="#8c8c8c"
                                              Grid.Column="1"
                                              Margin="0,0,10,0"
                                              VerticalAlignment="Center"
                                              HorizontalAlignment="Left"/>
                            </Grid>
                        </Border>

                        <ControlTemplate.Triggers>

                            <!--Hover-->
                            <Trigger Property="IsMouseOver"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#FF6800"/>
                            </Trigger>

                            <!--Focus-->
                            <Trigger Property="IsKeyboardFocused"
                                     Value="True">
                                <Setter TargetName="border"
                                        Property="BorderBrush"
                                        Value="#FF6800"/>
                            </Trigger>

                            <!--Disabled-->
                            <Trigger Property="IsEnabled"
                                     Value="False">
                                <Setter TargetName="border"
                                        Property="Opacity"
                                        Value="0.5"/>
                            </Trigger>

                        </ControlTemplate.Triggers>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <!--Not active!-->
        <Style x:Key="RoundedButton"
               TargetType="Button">
            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Background"
                    Value="#EF6D19"/>
            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">
                        <Border x:Name="RootBorder"
                                Background="{TemplateBinding Background}"
                                CornerRadius="14">
                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"
                                              Margin="{TemplateBinding Padding}"/>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="RoundedButton2"
               TargetType="Button">

            <Setter Property="BorderThickness"
                    Value="0"/>
            <Setter Property="Cursor"
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <!--ROOT-->
                        <Border x:Name="Root"
                                CornerRadius="15">

                            <!--FESTER GRADIENT-->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop x:Name="StopTop"
                                                  Color="#FF6800"
                                                  Offset="0"/>
                                    <GradientStop x:Name="StopBottom"
                                                  Color="#e64500"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF6800"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#e64500"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>
                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFB347"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF7A18"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFD166"
                                                            Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF9F1C"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>
    </Window.Resources>

    <!--OUTER BORDER (IMAGE)-->
    <Border CornerRadius="20">
        <Border.Background>
            <ImageBrush ImageSource="/Icons/NexusLoginBackgroundVorlage1.jpg"
                        Stretch="UniformToFill"
                        AlignmentX="Center"
                        AlignmentY="Center"/>
        </Border.Background>

        <!--MAIN GRID-->
        <Grid>

            <Grid.RowDefinitions>
                <RowDefinition Height="40"/>
                <RowDefinition Height="*"/>
            </Grid.RowDefinitions>

            <!--TITLE BAR-->
            <Border Grid.Row="0"
                    Background="Transparent"
                    MouseDown="Border_MouseDown">

                <Grid>
                    <StackPanel Orientation="Horizontal"
                                HorizontalAlignment="Right"
                                Margin="0,0,11,0">

                        <Button Width="20"
                                Height="20"
                                Content="━"
                                Click="ButtonMinimize_Click"
                                Style="{StaticResource MinMaxCloseButton}"
                                Margin="0,0,6,0"/>

                        <Button Width="20"
                                Height="20"
                                Content="◻"
                                Click="ButtonMaximize_Click"
                                Style="{StaticResource MinMaxCloseButton}"
                                Margin="0,0,6,0"/>

                        <Button Width="20"
                                Height="20"
                                Content="🗙"
                                Click="ButtonClose_Click"
                                Style="{StaticResource MinMaxCloseButton}"/>
                    </StackPanel>
                </Grid>
            </Border>

            <!--INNER BORDER (LOGIN CONTAINER)-->
            <Border Grid.Row="1"
                    Width="420"
                    Height="540"
                    CornerRadius="20"
                    VerticalAlignment="Center"
                    HorizontalAlignment="Center"
                    Background="#4d1700">

                <!--ORANGE GLOW-->
                <Border.Effect>
                    <DropShadowEffect Color="#fc9b53"
                                      BlurRadius="85"
                                      ShadowDepth="0"
                                      Opacity="0.4"/>
                </Border.Effect>

                <!--INNERER BORDER (CONTENT)-->
                <Border Width="418"
                        Height="538"
                        CornerRadius="20"
                        Background="#0d0400">

                    <!--LOGIN CONTENT-->
                    <StackPanel VerticalAlignment="Center"
                                HorizontalAlignment="Center">

                        <Image Source="/Icons/NexusLogo5.png"
                               RenderOptions.BitmapScalingMode="Fant"
                               Width="75"
                               Height="75"
                               Margin="0,10,0,10"/>
                        
                        <Label Content="NEXUS LOGIN"
                               FontWeight="Bold"
                               FontSize="35"
                               HorizontalAlignment="Center"
                               Margin="0,0,0,-5">

                            <Label.Foreground>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop Color="#FF7A18" 
                                                  Offset="0"/>
                                    <GradientStop Color="#FF6800" 
                                                  Offset="0.5"/>
                                    <GradientStop Color="#e64500" 
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Label.Foreground>

                        </Label>

                        <Label Content="v0.0.02"
                               Foreground="#BEBEBE"
                               FontSize="15"
                               HorizontalAlignment="Center"
                               Margin="0,-5,0,30"/>

                        <Label Content="USERNAME"
                               Foreground="#FFD166"
                               FontSize="15"
                               HorizontalAlignment="Left"
                               Margin="0,0,0,0"/>

                        <TextBox x:Name="userNametxt"
                                 TextAlignment="Center"
                                 FontSize="13"
                                 Height="38"
                                 Width="300"
                                 Margin="0,5,0,0"
                                 Style="{StaticResource RoundedTextboxStyle}"/>

                        <Label Content="PASSWORD"
                               Foreground="#FFD166"
                               FontSize="15"
                               Margin="0,10,0,0"
                               HorizontalAlignment="Left"/>

                        <PasswordBox x:Name="passwordtxt"
                                     HorizontalContentAlignment="Center"
                                     FontSize="13"
                                     Height="38"
                                     Width="300"
                                     Margin="0,5,0,0"
                                     Style="{StaticResource RoundedPasswordboxStyle}"/>

                        <Button x:Name="loginButton"
                                Content="LOG IN"
                                Click="LoginButton_Click"
                                Foreground="White"
                                FontSize="14"
                                Height="32"
                                Width="300"
                                Margin="0,30,0,0"
                                Style="{StaticResource RoundedButton2}"/>

                        <Button x:Name="registerButton"
                                Content="SIGN UP"
                                Click="RegisterButton_Click"
                                Foreground="White"
                                FontSize="14"
                                Height="32"
                                Width="300"
                                Margin="0,20,0,0"
                                Style="{StaticResource RoundedButton2}"/>

                        <Border Height="1"
                                Width="300"
                                Background="#4d1700"
                                HorizontalAlignment="Center"
                                Margin="0,20"/>

                        <Label Content="© 2026 NEXUS DEVELOPED BY AFOS"
                               Foreground="#802600"
                               FontSize="11"
                               Margin="0,-13,0,0"
                               HorizontalAlignment="Center"/>

                    </StackPanel>
                </Border>
            </Border>
        </Grid>
    </Border>
</Window>