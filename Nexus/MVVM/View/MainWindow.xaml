                    Value="0"/>
            <Setter Property="Cursor" 
                    Value="Hand"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <!--ROOT-->
                        <Border x:Name="Root"
                                CornerRadius="20">

                            <!--FESTER GRADIENT-->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="1,0">
                                    <GradientStop x:Name="StopTop"
                                                  Color="#FF6800"
                                                  Offset="0"/>
                                    <GradientStop x:Name="StopBottom"
                                                  Color="#e64500"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                            <VisualStateManager.VisualStateGroups>
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF6800"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#e64500"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFB347"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF7A18"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFD166"
                                                            Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FF9F1C"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>
                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ContactButton"
               TargetType="Button">

            <Setter Property="Cursor"
                    Value="Hand"/>
            <Setter Property="Foreground"
                    Value="White"/>
            <Setter Property="BorderThickness"
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="Button">

                        <!--RAHMEN-->
                        <Border CornerRadius="20"
                                Padding="2">

                            <Border.Background>
                                <LinearGradientBrush x:Name="FrameBrush"
                                                     StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop x:Name="FrameTop"
                                                  Color="#EF6D19"
                                                  Offset="0"/>
                                    <GradientStop x:Name="FrameBottom"
                                                  Color="#212121"
                                                  Offset="0.5"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <!--BUTTON-FLÄCHE-->
                            <Border x:Name="InnerBorder"
                                    CornerRadius="18">

                                <Border.Background>
                                    <LinearGradientBrush x:Name="InnerBackgroundBrush"
                                                         StartPoint="0,0"
                                                         EndPoint="0,1">
                                        <!--Oben: Schwarz-->
                                        <GradientStop x:Name="InnerTop"
                                                      Color="#000000"
                                                      Offset="0"/>

                                        <!--Unten: #212121-->
                                        <GradientStop x:Name="InnerBottom"
                                                      Color="#212121"
                                                      Offset="1"/>
                                    </LinearGradientBrush>
                                </Border.Background>

                                <ContentPresenter HorizontalAlignment="Center"
                                                  VerticalAlignment="Center"/>
                            </Border>
                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="ChooseToggleButton"
               TargetType="ToggleButton">

            <Setter Property="BorderThickness" 
                    Value="0"/>
            <Setter Property="Cursor" 
                    Value="Hand"/>
            <Setter Property="FontSize" 
                    Value="16"/>
            <Setter Property="Foreground" 
                    Value="White"/>
            <Setter Property="Padding" 
                    Value="0"/>

            <Setter Property="Template">
                <Setter.Value>
                    <ControlTemplate TargetType="ToggleButton">

                        <!--ROOT-->
                        <Border x:Name="Root"
                                CornerRadius="20">

                            <!--GRADIENT-->
                            <Border.Background>
                                <LinearGradientBrush StartPoint="0,0"
                                                     EndPoint="0,1">
                                    <GradientStop x:Name="StopTop"
                                                  Color="#FF8A3D"
                                                  Offset="0"/>
                                    <GradientStop x:Name="StopBottom"
                                                  Color="#EF6D19"
                                                  Offset="1"/>
                                </LinearGradientBrush>
                            </Border.Background>

                            <ContentPresenter HorizontalAlignment="Center"
                                              VerticalAlignment="Center"/>

                            <VisualStateManager.VisualStateGroups>

                                <!--COMMON-->
                                <VisualStateGroup x:Name="CommonStates">

                                    <VisualState x:Name="Normal"/>

                                    <VisualState x:Name="MouseOver">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#FFD166"
                                                            Duration="0:0:0.2"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#F4A23A"
                                                            Duration="0:0:0.2"/>
                                        </Storyboard>
                                    </VisualState>

                                    <VisualState x:Name="Pressed">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#E6F86A"
                                                            Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#F5FE53"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>

                                <!--CHECK STATES-->
                                <VisualStateGroup x:Name="CheckStates">

                                    <VisualState x:Name="Unchecked"/>

                                    <VisualState x:Name="Checked">
                                        <Storyboard>
                                            <ColorAnimation Storyboard.TargetName="StopTop"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#E6F86A"
                                                            Duration="0:0:0.12"/>
                                            <ColorAnimation Storyboard.TargetName="StopBottom"
                                                            Storyboard.TargetProperty="Color"
                                                            To="#F5FE53"
                                                            Duration="0:0:0.12"/>
                                        </Storyboard>
                                    </VisualState>

                                </VisualStateGroup>

                            </VisualStateManager.VisualStateGroups>

                        </Border>
                    </ControlTemplate>
                </Setter.Value>
            </Setter>
        </Style>

        <Style x:Key="HoverTabContainerStyle"
               TargetType="Grid">

            <Setter Property="Width" 
                    Value="350"/>
            <Setter Property="Height" 
                    Value="190"/>
            <Setter Property="Cursor" 
                    Value="Hand"/>

            <Setter Property="RenderTransformOrigin" 
                    Value="0.5,0.5"/>
            <Setter Property="RenderTransform">
                <Setter.Value>
                    <ScaleTransform ScaleX="1"
                                    ScaleY="1"/>
                </Setter.Value>
            </Setter>

            <!--Gleichmäßiger Schatten-->
            <Setter Property="Effect">
                <Setter.Value>
                    <DropShadowEffect BlurRadius="14"
                                      ShadowDepth="0"
                                      Opacity="0.35"/>
                </Setter.Value>
            </Setter>

            <Style.Triggers>
                <Trigger Property="IsMouseOver" 
                         Value="True">
                    <Trigger.EnterActions>
                        <BeginStoryboard>
                            <Storyboard>

                                <!--Scale-->
                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1.05"
                                                 Duration="0:0:0.18"
                                                 AccelerationRatio="0.4"/>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1.05"
                                                 Duration="0:0:0.18"
                                                 AccelerationRatio="0.4"/>

                                <!--Shadow-->
                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 To="22"
                                                 Duration="0:0:0.18"/>

                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.55"
                                                 Duration="0:0:0.18"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.EnterActions>

                    <Trigger.ExitActions>
                        <BeginStoryboard>
                            <Storyboard>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleX)"
                                                 To="1"
                                                 Duration="0:0:0.22"
                                                 DecelerationRatio="0.5"/>

                                <DoubleAnimation Storyboard.TargetProperty="RenderTransform.(ScaleTransform.ScaleY)"
                                                 To="1"
                                                 Duration="0:0:0.22"
                                                 DecelerationRatio="0.5"/>

                                <DoubleAnimation Storyboard.TargetProperty="Effect.BlurRadius"
                                                 To="14"
                                                 Duration="0:0:0.22"/>

                                <DoubleAnimation Storyboard.TargetProperty="Effect.Opacity"
                                                 To="0.35"
                                                 Duration="0:0:0.22"/>

                            </Storyboard>
                        </BeginStoryboard>
                    </Trigger.ExitActions>
                </Trigger>
            </Style.Triggers>
        </Style>
    </Window.Resources>

    <Border CornerRadius="20">
        <Border.Background>
            <LinearGradientBrush StartPoint="0,0" 
